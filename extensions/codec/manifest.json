{
  "id": "codec",
  "name": "__MSG_name__",
  "version": "0.1.0",
  "description": "__MSG_description__",
  "author": "Spotcat",
  "icon": "sf:chevron.left.forwardslash.chevron.right",
  "iconColor": "#3B82F6",
  "main": "index.html",
  "defaultLocale": "zh-Hans",
  "features": [
    {
      "code": "url-encode",
      "title": "__MSG_urlEncode__",
      "keywords": [
        "url encode",
        "urlencode",
        "__MSG_kwUrlEncode__",
        "__MSG_kwEncode__"
      ]
    },
    {
      "code": "url-decode",
      "title": "__MSG_urlDecode__",
      "keywords": [
        "url decode",
        "urldecode",
        "__MSG_kwUrlDecode__",
        "__MSG_kwDecode__"
      ],
      "matches": [
        {
          "type": "regex",
          "pattern": "%[0-9A-Fa-f]{2}",
          "minLength": 3,
          "maxLength": 100000
        }
      ]
    },
    {
      "code": "base64-encode",
      "title": "__MSG_base64Encode__",
      "keywords": [
        "base64",
        "base64 encode",
        "__MSG_kwBase64Encode__",
        "__MSG_kwEncode__"
      ]
    },
    {
      "code": "base64-decode",
      "title": "__MSG_base64Decode__",
      "keywords": [
        "base64 decode",
        "__MSG_kwBase64Decode__",
        "__MSG_kwDecode__"
      ],
      "matches": [
        {
          "type": "regex",
          "pattern": "^(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9+/=])(?:[A-Za-z0-9+/]{4}){2,}(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 8,
          "maxLength": 100000
        }
      ]
    }
  ]
}
